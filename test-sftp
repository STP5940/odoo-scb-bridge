#!/usr/bin/env bash
# Git Bash launcher: bypasses cmd.exe batch interruption prompts and forwards Ctrl+C cleanly.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/scripts/test-sftp.ps1"
status=$?
if (( status == 130 )); then
  exit 130
fi
exit "$status"